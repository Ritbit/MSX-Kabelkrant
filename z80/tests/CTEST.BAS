10 SCREEN 0:WIDTH 40:CLS
20 PRINT "KBL Z80 C: RAMDISK REGRESSION"
30 PRINT "Independent read/write/delete test"
40 ON ERROR GOTO 9000
50 F$="C:KBTST26.TMP"
60 A$="KBL-Z80-TEST-20261110"
70 B$="0123456789ABCDEF"
80 PRINT "1. Writing C: test file..."
90 OPEN F$ FOR OUTPUT AS #1
100 PRINT #1,A$
110 PRINT #1,B$
120 CLOSE #1
130 PRINT "2. Reading and comparing..."
140 OPEN F$ FOR INPUT AS #1
150 LINE INPUT #1,C$
160 LINE INPUT #1,D$
170 CLOSE #1
180 IF C$<>A$ THEN 8000
190 IF D$<>B$ THEN 8000
200 PRINT "3. Deleting test file..."
210 KILL F$
220 PRINT "PASS: WRITE/READ/DELETE ON C:"
230 PRINT "Restart Kabelkrant by RESET"
240 END
8000 PRINT "FAIL: CONTENT MISMATCH"
8010 PRINT "Expected:";A$;" / ";B$
8020 PRINT "Read:    ";C$;" / ";D$
8030 PRINT "Test file remains on C:"
8040 END
9000 PRINT "FAIL: BASIC ERROR";ERR;"AT";ERL
9010 PRINT "Test file may remain: ";F$
9020 END
